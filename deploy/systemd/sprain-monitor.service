[Unit]
Description=Verificação externa de disponibilidade do SPRain
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=sprain-monitor
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/sprain/monitor.env
ExecStart=/usr/bin/python3 /opt/sprain/scripts/monitorar_disponibilidade.py --url ${SPRAIN_HEALTH_URL} --webhook-url ${SPRAIN_DISCORD_WEBHOOK} --state-file /var/lib/sprain-monitor/state.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
